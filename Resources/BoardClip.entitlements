<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allows loading the embedded Sparkle.framework when the app and framework are
         signed with different (or ad-hoc) identities. Required for Sparkle + hardened runtime. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Hardened runtime blocks photo-library access without this; needed for "Save to Photos"
         (the prompt won't even appear otherwise). -->
    <key>com.apple.security.personal-information.photos-library</key>
    <true/>
</dict>
</plist>
